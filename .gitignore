.worktrees/
.local/
logs/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
# Backstop for hand-made copies -- .env.bak, .env.local, .env.prod. The bare
# `.env` rule matches that name and nothing else, and an edited .env usually
# leaves a backup beside it carrying the same live keys.
.env.*
!.env.example
*.egg-info/
dist/
.coverage

# Database dumps -- they carry users.password_hash and api_keys.key_hash.
#
# File them in beacon.dump/, where any name is ignored. Name them for when the
# dump was TAKEN: its whole value is which state of the database it captures.
#
# The root globs are a backstop and cannot be complete. Nothing in this tree
# produces dumps -- no pg_dump target in the Makefile, no caller anywhere -- so
# names are typed by hand, and pg_dump's default output format is plain SQL:
# beacon.bak, beacon.pgdump, beacon.custom and beacon.sql all miss, as does a
# differently-named directory like dumps/ or beacon.dumps/.
#
# An uncovered dump is not silent -- it shows as `?? beacon.bak` in git status,
# and that is the only signal there is. It is also the signal that got ignored
# for days while a 41 MB dump sat in the repo root, one `git add -A` from being
# in history forever.
#
# Bare *.sql is deliberately absent: in a text-to-SQL repo a .sql file is
# likelier to be a fixture someone means to commit, and an ignore rule that
# silently drops a file from `git add` is this defect pointed backwards.
beacon.dump/
*.dump
*.dump.*
*.backup
*.sql.gz

# Claude Code local settings. Grants SSM command execution against the
# production beacon instance -- an access grant, not a preference. Never commit.
.claude/settings.local.json
