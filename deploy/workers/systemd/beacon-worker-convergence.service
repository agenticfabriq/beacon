[Unit]
Description=Beacon convergence worker (continuous tier promotion)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=beacon
Group=beacon
WorkingDirectory=/opt/beacon
EnvironmentFile=/etc/beacon/worker.env
EnvironmentFile=-/etc/beacon/worker-convergence.env
ExecStart=/opt/beacon/.venv/bin/beacon-worker-convergence
Restart=on-failure
RestartSec=15s
StartLimitInterval=600
StartLimitBurst=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/beacon /var/log/beacon
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beacon-worker-convergence

[Install]
WantedBy=multi-user.target
