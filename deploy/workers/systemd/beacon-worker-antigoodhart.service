[Unit]
Description=Beacon anti-Goodhart auditor (5-min scan)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=beacon
Group=beacon
WorkingDirectory=/opt/beacon
EnvironmentFile=/etc/beacon/worker.env
EnvironmentFile=-/etc/beacon/worker-antigoodhart.env
ExecStart=/opt/beacon/.venv/bin/beacon-worker-antigoodhart
Restart=on-failure
RestartSec=15s
StartLimitInterval=600
StartLimitBurst=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/beacon /var/log/beacon
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beacon-worker-antigoodhart

[Install]
WantedBy=multi-user.target
