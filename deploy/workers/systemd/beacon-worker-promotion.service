[Unit]
Description=Beacon promotion worker (extract candidate eval items hourly)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=beacon
Group=beacon
WorkingDirectory=/opt/beacon
EnvironmentFile=/etc/beacon/worker.env
EnvironmentFile=-/etc/beacon/worker-promotion.env
ExecStart=/opt/beacon/.venv/bin/beacon-worker-promotion
Restart=on-failure
RestartSec=15s
StartLimitInterval=600
StartLimitBurst=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/beacon /var/log/beacon
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beacon-worker-promotion

[Install]
WantedBy=multi-user.target
