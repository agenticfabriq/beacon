# Copy to .env (gitignored) and fill in. Values here are placeholders; the
# real judge endpoint and key are deployment configuration and must never be
# committed.

DATABASE_URL=postgresql+psycopg://beacon:beacon_dev@localhost:5432/beacon
BEACON_OBJECT_STORAGE=local:///tmp/beacon-objects
BEACON_OIDC_ISSUER=
BEACON_OIDC_CLIENT_ID=
BEACON_OIDC_CLIENT_SECRET=
BEACON_JWT_SIGNING_KEY=change-me-in-prod
BEACON_API_KEY_PREFIX=bcn_dev

# LLM judge for narrative/rubric graders (OpenAI-compatible chat completions).
# All three must be set for the judge to activate; leave empty to disable.
BEACON_JUDGE_BASE_URL=
BEACON_JUDGE_API_KEY=
BEACON_JUDGE_MODEL=

# repo-guard's proprietary-name blocklist (regex). Lives only here and in the
# CI secret of the same name -- never in the repo.
REPO_GUARD_NAME_PATTERNS=
